@startuml "Контейнерная диаграмма - Система открытия депозитов онлайн"
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml

title "Контейнерная диаграмма - Система открытия депозитов онлайн"

Person(client, "Клиент", "Клиент банка, который хочет открыть депозит")
Person(callCenterOperator, "Сотрудник кол-центра", "Обрабатывает заявки с сайта")
Person(backOfficeEmployee, "Сотрудник бэк-офиса", "Обрабатывает заявки и управляет ставками")

System_Boundary(depositSystem, "Система открытия депозитов онлайн") {
    Container(website, "Сайт", "PHP, React.js", "Отображает информацию о депозитах и позволяет подавать заявки")
    Container(internetBank, "Интернет-банк", "ASP.NET MVC 4.5, MS SQL", "Позволяет клиентам управлять счетами и открывать депозиты")
    Container(apiGateway, "API Gateway", "ASP.NET Core", "Маршрутизирует запросы к соответствующим сервисам")
    Container(depositService, "Сервис управления депозитами", "Java Spring Boot, MS SQL", "Обрабатывает заявки на открытие депозитов")
    Container(rateService, "Сервис управления ставками", "Java Spring Boot, MS SQL", "Управляет ставками по депозитам")
    Container(integrationLayer, "Интеграционный слой", "Java, Oracle", "Изолирует прямое взаимодействие с АБС")
    Container(messageBroker, "Брокер сообщений", "RabbitMQ", "Обеспечивает асинхронный обмен сообщениями")
}

Container_Ext(callCenterSystem, "Система кол-центра", "React.js, Java Spring Boot, PostgreSQL", "Система для работы операторов кол-центра")
Container_Ext(abs, "Автоматизированная банковская система (АБС)", "Delphi, PL-SQL, Oracle", "Основная банковская система")
System_Ext(smsGateway, "SMS-шлюз", "Отправляет SMS-уведомления и коды подтверждения")

Rel(client, website, "Просматривает и подает заявки через", "HTTPS")
Rel(client, internetBank, "Управляет счетами и открывает депозиты через", "HTTPS")
Rel(website, apiGateway, "Отправляет запросы в", "HTTPS")
Rel(internetBank, apiGateway, "Отправляет запросы в", "HTTPS")
Rel(apiGateway, depositService, "Перенаправляет запросы в", "REST API")
Rel(depositService, rateService, "Запрашивает информацию о ставках", "REST API")
Rel(depositService, integrationLayer, "Отправляет запросы в", "REST API")
Rel(integrationLayer, abs, "Взаимодействует с", "DB API")
Rel(depositService, messageBroker, "Публикует сообщения в", "AMQP")
Rel(callCenterSystem, messageBroker, "Получает заявки из", "AMQP")
Rel(messageBroker, smsGateway, "Отправляет запросы на отправку SMS через", "SMPP")
Rel(callCenterOperator, callCenterSystem, "Использует")
Rel(backOfficeEmployee, rateService, "Управляет ставками через")
Rel(backOfficeEmployee, abs, "Обрабатывает заявки в")
Rel(smsGateway, client, "Отправляет SMS-уведомления и коды подтверждения")
Rel(apiGateway, callCenterSystem, "Перенаправляет заявки с сайта в", "REST API")

@enduml