@startuml "Контекстная диаграмма - Доступ к ставкам по депозитам для кол-центров"
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Context.puml

title "Контекстная диаграмма - Доступ к ставкам по депозитам для кол-центров"

Person(client, "Клиент", "Запрашивает информацию о ставках по депозитам")
Person(bankOperator, "Сотрудник кол-центра банка", "Консультирует клиентов по ставкам")
Person(partnerOperator, "Сотрудник партнёрского кол-центра", "Консультирует клиентов по ставкам")

System(depositRateSystem, "Система управления ставками", "Управляет ставками по депозитам")
System(bankCallCenter, "Система кол-центра банка", "Используется сотрудниками банка")
System(partnerCallCenter, "Система партнёрского кол-центра", "Используется сотрудниками партнёра")
System(sftpServer, "SFTP-сервер", "Хранит файлы со ставками для партнёров")

Rel(client, bankOperator, "Звонит и запрашивает информацию")
Rel(client, partnerOperator, "Звонит и запрашивает информацию")
Rel(bankOperator, bankCallCenter, "Использует для просмотра ставок")
Rel(partnerOperator, partnerCallCenter, "Использует для просмотра ставок")
Rel(bankCallCenter, depositRateSystem, "Получает данные о ставках через API")
Rel(depositRateSystem, sftpServer, "Выгружает файлы со ставками")
Rel(partnerCallCenter, sftpServer, "Загружает файлы со ставками")

@enduml